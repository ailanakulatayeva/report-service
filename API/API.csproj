  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infrastructure\Migrations\" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Shared\Contracts\Contracts.csproj" />
	<ProjectReference Include="..\Shared\Providers\Providers.csproj" />
  </ItemGroup>
	  
</Project>
